{
  "name": "geomuse",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "Apache-2.0",
  "scripts": {
    "predev": "node scripts/sync-static-assets.mjs",
    "dev": "next dev",
    "prebuild": "node scripts/sync-static-assets.mjs",
    "build": "next build",
    "start": "pnpm preview:cloudflare",
    "preview:cloudflare": "WRANGLER_LOG_PATH=.wrangler/logs wrangler dev --local",
    "deploy:cloudflare": "WRANGLER_LOG_PATH=.wrangler/logs wrangler deploy",
    "deploy:cloudflare:check": "WRANGLER_LOG_PATH=.wrangler/logs wrangler deploy --dry-run",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "node --test src/cloudflare/*.test.ts src/globe/*.test.ts src/security/*.test.ts",
    "test:smoke": "pnpm build && pnpm test:smoke:run",
    "test:smoke:run": "playwright test",
    "test:smoke:touch": "pnpm build && pnpm test:smoke:touch:run",
    "test:smoke:touch:run": "playwright test --grep @touch",
    "test:smoke:install": "playwright install chromium",
    "perf:budget": "node scripts/verify-performance-budget.mjs",
    "data:basemap": "node scripts/build-basemap.mjs",
    "data:verify": "node scripts/verify-basemap.mjs",
    "data:http": "node scripts/verify-pmtiles-http.mjs"
  },
  "dependencies": {
    "maplibre-gl": "5.12.0",
    "motion": "12.42.2",
    "next": "16.2.11",
    "pmtiles": "4.4.1",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@playwright/test": "1.62.0",
    "@tailwindcss/postcss": "4.3.3",
    "@types/geojson": "7946.0.16",
    "@types/node": "26.1.1",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "eslint": "9.39.5",
    "eslint-config-next": "16.2.11",
    "geojson-vt": "4.0.3",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vt-pbf": "3.1.3",
    "wrangler": "4.106.0"
  },
  "packageManager": "pnpm@11.9.0"
}
